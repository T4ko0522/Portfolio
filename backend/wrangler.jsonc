{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "portfolio-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "api.t4ko.pet", "custom_domain": true }],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SpotifyStatusDO"],
    },
    {
      "tag": "v2",
      "deleted_classes": ["SpotifyStatusDO"],
    },
  ],
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 },
    },
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true,
    },
  },
}
