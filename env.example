# Copy this file to `.env.local` (Next.js auto-loads it) and fill in the values.

# --- Resend (https://resend.com) ---
RESEND_API_KEY=

# Email recipient and sender. While the sender domain is not verified on
# Resend, you must keep `onboarding@resend.dev` as the from address.
CONTACT_TO_EMAIL=tako.work.contact@gmail.com
CONTACT_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>

# --- Cloudflare Turnstile (https://developers.cloudflare.com/turnstile/) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
